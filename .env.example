# ---- Backend (backend/.env or Cloud Run env / Secret Manager) ----
ENV=dev
# Neon: pooled URL (hostname contains -pooler) for the app, direct URL for Alembic.
DATABASE_URL=postgresql://raktsetu:raktsetu@localhost:55432/raktsetu
DATABASE_URL_DIRECT=
AUTH_MODE=both                 # firebase | demo | both
DEMO_AUTH_SECRET=change-me     # REQUIRED in prod when demo auth is on (Secret Manager)
FIREBASE_PROJECT_ID=
# Gemini: either an AI Studio key (free, no card) ...
GEMINI_API_KEY=
# ... or Vertex AI with Application Default Credentials on Cloud Run:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash   # tried when the main model is busy (503/429)
MAPS_SERVER_KEY=               # Routes API (server key, restricted)
GOOGLE_CALENDAR_API_KEY=       # public holiday calendar
FIRESTORE_ENABLED=false
FCM_ENABLED=false
BIGQUERY_DATASET=              # e.g. raktsetu (BigQuery sandbox works without billing)
INTERNAL_AUDIENCE=             # Cloud Run URL; Cloud Scheduler OIDC audience
SCHEDULER_SA_EMAIL=
INTERNAL_TOKEN=                # for non-GCP schedulers (Render cron / GitHub Actions)
BREVO_API_KEY=
ALERT_EMAIL_TO=
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (frontend/.env) - see frontend/.env.example ----

# --- Groq (free, no card): fallback LLM when Gemini is busy --------------------------
# console.groq.com -> API Keys -> Create. Blank = template answers when Gemini is down.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

